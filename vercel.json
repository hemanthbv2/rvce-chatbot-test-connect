{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/interactions",
      "destination": "/dashboard/interactions.html"
    },
    {
      "source": "/dashboard/sessions",
      "destination": "/dashboard/sessions.html"
    },
    {
      "source": "/dashboard/analytics",
      "destination": "/dashboard/analytics.html"
    },
    {
      "source": "/dashboard/:match*",
      "destination": "/dashboard/:match*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/:match*"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}